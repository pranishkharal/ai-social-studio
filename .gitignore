# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large Media Buffers & Video Clips (Stored locally on D: drive)
buffer/
clips/
edited/
vod/
subtitles/
chrome_user_data/
static/mov_inspection/
*.mp4
*.ts
*.ass
*.m3u8
*.mp3

# Databases & logs
*.db
*.db-journal
*.log
server.log
server_err.log

# Temporary test outputs
test_*.png
test_*.mp4
preview_frame.png
caption_card.png

# Environment & credentials
.env
.venv/
env/
venv/
ENV/

# OAuth / API credentials (Tier 2 uploaders)
token.json
client_secrets.json

# Bulk Gemini API keys (gemini_keys.py) — pasted in the dashboard, never committed
gemini_keys.json

# Runtime-generated state (Tiers 3-4)
checkpoints/
face_references/
overlays/

# ML model files — auto-downloaded into models/ on first use
# (e.g. MediaPipe BlazeFace .tflite, pose landmarker .task). Never commit:
# they are binaries the snapshot push cannot carry, and they re-download.
*.tflite
*.task

# Backups & cached thumbnails
backups/
static/thumbnails/
