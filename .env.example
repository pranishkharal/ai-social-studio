# ============================================================================
# ai-social-studio — environment configuration
# Copy this file to `.env` and fill in the values you need. Everything below
# has a safe default: the engine runs out of the box with only GEMINI_API_KEY.
# Never commit your real `.env` — it is gitignored.
# ============================================================================

# --- Core -------------------------------------------------------------------
# Gemini API Key (Get free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Preferred Vertical Layout: 'blurred_backdrop' (Universal) or 'split' (Top Facecam, Bottom Game)
VIDEO_LAYOUT=blurred_backdrop

# Streamers to monitor automatically on start (comma separated)
MONITORED_STREAMERS=adinross,xqc,westcol,tarik

# --- Tier 1: automatic live clipping ---------------------------------------
# Master switch for the auto-clip watcher. OFF by default: clips are only
# made when you click the button in the dashboard (or set this to true).
AUTO_CLIP_ENABLED=false
# Combined hype score (0-100, audio + chat) needed to trigger an auto-clip.
AUTO_CLIP_MIN_SCORE=70
# Seconds between hype checks.
AUTO_CLIP_CHECK_SECONDS=5
# Seconds of footage per auto-clip (overridden by the streamer's profile
# when the profile sets clip_seconds).
AUTO_CLIP_DURATION=25
# Seconds of audio sampled from the buffer for each hype check.
AUTO_CLIP_SAMPLE_SECONDS=5
# Minimum seconds between auto-clips of the same streamer.
AUTO_CLIP_COOLDOWN_SECONDS=90
# Duplicate protection: a new clip whose title/summary is this similar
# (0.0-1.0 word overlap) to a recent clip is skipped.
AUTO_CLIP_DUP_SIMILARITY=0.7
AUTO_CLIP_DUP_WINDOW_MINUTES=30

# --- Tier 1: live chat hype (Kick chat via Pusher websocket) ----------------
# Needs `websocket-client` (in requirements.txt). OFF by default.
CHAT_HYPE_ENABLED=false
# Pusher app key Kick's web chat uses (public; override only if Kick changes it).
KICK_PUSHER_APP_KEY=32cbd69e4b950bf97679
# Emotes / keywords that count as hype (comma separated).
CHAT_HYPE_EMOTES=KEKW,Pog,OMEGALUL,LUL,Kappa,PepeLaugh,5Head,Clueless,POGGERS,EZ
CHAT_HYPE_KEYWORDS=CLIP IT,WTF,LOL,CLIP,INSANE,NO WAY
# Rolling window (seconds) chat velocity is measured over.
CHAT_HYPE_WINDOW_SECONDS=10
# Hype score (0-100) at/above which the chat callback fires.
CHAT_HYPE_THRESHOLD=70
# Seconds between chat-hype callbacks per chatroom.
CHAT_HYPE_CALLBACK_COOLDOWN=30

# --- Tier 1: Kick webhooks (instant live detection) -------------------------
# Create an app at kick.com/settings/developer. Without these, live
# detection uses the 15 s polling loop (which still works fine).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# OAuth access token for the Kick API (used by /api/webhooks/subscribe).
KICK_ACCESS_TOKEN=
# Public HTTPS URL of this server, e.g. https://clips.example.com
KICK_WEBHOOK_URL=
# Optional PEM public-key override for signature verification. Kick signs
# webhooks with RSA-SHA256; the key is normally fetched from Kick's API,
# so leave this empty unless verification fails.
KICK_WEBHOOK_SECRET=

# --- Tier 2: YouTube Shorts uploader ----------------------------------------
# Google Cloud OAuth client secrets (Desktop app type) + the token file the
# first browser sign-in creates. Both are gitignored — never commit them.
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json

# --- Tier 2: Instagram Reels uploader ---------------------------------------
# Meta Graph API: a Business/Creator Instagram account linked to a Facebook
# Page, with an access token that has instagram_content_publish.
# NOTE: Instagram only accepts a publicly reachable video URL, so Reels
# uploads need the clip hosted somewhere public first.
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_POLL_INTERVAL_SECONDS=5
INSTAGRAM_POLL_TIMEOUT_SECONDS=300

# --- Tier 2: upload scheduler -----------------------------------------------
# Minimum minutes between uploads on each platform (anti-spam spacing).
TIKTOK_MIN_GAP_MINUTES=180
YOUTUBE_MIN_GAP_MINUTES=120
INSTAGRAM_MIN_GAP_MINUTES=180
# Maximum uploads per platform per day.
TIKTOK_MAX_PER_DAY=5
YOUTUBE_MAX_PER_DAY=5
INSTAGRAM_MAX_PER_DAY=5
# Retries per queued upload job before it is marked failed.
UPLOAD_MAX_ATTEMPTS=3
# Seconds between scheduler queue checks.
UPLOAD_SCHEDULER_POLL_SECONDS=60

# --- Tier 3: transcription --------------------------------------------------
# faster-whisper model: tiny (default, fastest) / base / small / medium / large-v3.
WHISPER_MODEL=tiny
# cpu (default) or cuda. CUDA falls back to CPU automatically if no GPU.
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=1
WHISPER_COMPUTE_TYPE=int8

# --- Tier 3: dead-space removal ---------------------------------------------
# Word gaps longer than this (seconds) are cut from the clip.
SILENCE_MAX_GAP_SECONDS=1.5
# Seconds of audio kept on each side of a cut so speech is not clipped.
SILENCE_PAD_SECONDS=0.15

# --- Tier 3: per-streamer profiles + face references ------------------------
STREAMER_PROFILES_PATH=streamer_profiles.json
# Folder of reference face photos (<streamer>.jpg) for face recognition.
FACE_REFERENCE_DIR=face_references

# --- Tier 4: dashboard login ------------------------------------------------
# Bind address: 127.0.0.1 = this computer only. 0.0.0.0 = also reachable
# on the local network, e.g. from an Android phone on the same Wi-Fi
# (open http://<your-computer-ip>:8500 in the phone browser). Set a
# dashboard password before exposing it on the network!
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500
# With neither password var set, the dashboard is open (a warning is logged). Set ONE:
# a plain password (hashed in memory on start) or a precomputed hash from
# auth.hash_password() — the hash is the safer option for shared machines.
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=
# Secret for signing session cookies. Random per process when unset, which
# logs everyone out on restart — set a stable value for a long-lived server.
DASHBOARD_SECRET_KEY=

# --- Tier 4: Discord / Telegram alerts --------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Tier 5: face tracking --------------------------------------------------
# auto (default: MediaPipe if installed, else YOLO if installed, else Haar),
# mediapipe, yolo, or haar.
FACE_TRACKER_BACKEND=auto
YOLO_FACE_MODEL=yolov8n-face.pt

# --- Tier 5: B-roll + background music --------------------------------------
# Pexels API key (free at https://www.pexels.com/api/). Without one,
# B-roll is silently skipped. BROLL_ENABLED also gates it per render.
PEXELS_API_KEY=
BROLL_ENABLED=false
# Folder of royalty-free MP3s in mood subfolders (chill/epic/upbeat/sad/
# suspense). No MP3s means no music. BGM_ENABLED also gates it per render.
BGM_DIR=assets/bgm
BGM_ENABLED=false

# --- Tier 5: LLM provider fallback ------------------------------------------
# OpenAI-compatible endpoint (LM Studio default) used when Gemini fails.
# Gemini -> local model -> keyword heuristic. Never blocks a clip.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
OPENAI_MODEL=local-model

# --- Tier 5: encoder + subtitles --------------------------------------------
# auto (default: NVENC > AMF > VAAPI > libx264, verified with a test
# encode) or an explicit ffmpeg encoder name such as libx264 / h264_nvenc.
VIDEO_ENCODER=auto
# classic (default: 2-3 word ASS captions) or karaoke (animated kinetic
# karaoke subtitles with per-syllable highlight + bounce).
SUBTITLE_STYLE=classic
